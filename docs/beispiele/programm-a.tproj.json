{
  "format": "testumgebung.projekt",
  "formatVersion": 1,
  "name": "Programm A",
  "version": "1.0",
  "description": "Beispiel-Testprogramm A (Spannungsprüfung).",
  "variables": [
    {
      "name": "Auftrag",
      "type": "String"
    },
    {
      "name": "Artikel",
      "type": "String"
    }
  ],
  "init": {
    "variables": [],
    "repeat": {
      "mode": "Once"
    },
    "resultBeforeRepeat": "Keep",
    "children": [
      {
        "art": "schritt",
        "block": "code",
        "parameters": {
          "Sprache": "C#",
          "Quelltext": "Log(\"Programm A startet – Auftrag \" + Auftrag + \", Artikel \" + Artikel);\nreturn Pass();",
          "Timeout": "30"
        },
        "id": "a-info",
        "name": "Start A"
      }
    ],
    "id": "init",
    "name": "Test Start / Init"
  },
  "loop": {
    "variables": [],
    "repeat": {
      "mode": "Endless"
    },
    "resultBeforeRepeat": "Keep",
    "children": [
      {
        "art": "gruppe",
        "id": "a-dut",
        "name": "Prüfling",
        "variables": [
          {
            "name": "Kennung",
            "type": "String"
          }
        ],
        "repeat": {
          "mode": "Once"
        },
        "resultBeforeRepeat": "Keep",
        "dutRun": true,
        "dutIdVariable": "Kennung",
        "children": [
          {
            "art": "schritt",
            "block": "werker",
            "id": "a-scan",
            "name": "Seriennummer erfassen",
            "parameters": {
              "Art": "Eingabe",
              "Text": "Seriennummer scannen",
              "Datentyp": "Text",
              "Pflicht": "true",
              "Ziel": "Kennung"
            }
          },
          {
            "art": "schritt",
            "block": "code",
            "parameters": {
              "Sprache": "C#",
              "Quelltext": "Log(\"Messe Spannung ...\");\nreturn Measured(230, 220, 240, \"V\");",
              "Timeout": "30"
            },
            "id": "a-mess",
            "name": "Spannung prüfen"
          }
        ]
      }
    ],
    "id": "loop",
    "name": "Test Loop / Testing"
  },
  "finalization": {
    "variables": [],
    "repeat": {
      "mode": "Once"
    },
    "resultBeforeRepeat": "Keep",
    "children": [
      {
        "art": "schritt",
        "block": "code",
        "id": "a-end",
        "name": "End A",
        "parameters": {
          "Sprache": "C#",
          "Quelltext": "Log(\"Prüfsitzung beendet: \" + Auftrag); return Pass();",
          "Timeout": "30"
        }
      }
    ],
    "id": "fin",
    "name": "Test End / Finalization"
  },
  "simulation": []
}

