            "id": "c-scan",
            "name": "Seriennummer erfassen"
          },
          {
            "art": "schritt",
            "block": "code",
            "parameters": {
              "Sprache": "C#",
              "Quelltext": "Log(\"Messe Strom ...\");\nreturn Measured(12, 11, 13, \"A\");",
              "Timeout": "30"
            },
            "id": "c-mess",
            "name": "Strom prüfen"
          }
        ],
        "id": "c-dut",
