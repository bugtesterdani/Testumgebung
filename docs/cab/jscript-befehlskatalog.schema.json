          "type": "string",
          "pattern": "^JS-[1-6]\\.\\d+(\\.\\d+)?$"
        },
        "abschnitt": {
          "type": "string",
          "pattern": "^[1-6]\\.\\d+(\\.\\d+)?$"
        },
        "art": {
          "enum": [
