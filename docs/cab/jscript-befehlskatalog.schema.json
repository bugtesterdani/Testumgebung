          }
        },
        "geprueft": {
          "type": "boolean"
        },
        "regeln": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hinweis": {
          "type": "string",
          "minLength": 1
        },
        "objektgrenzen": {
          "type": "object"
        },
        "kapazitaeten": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "groesse",
              "numerisch",
              "alphanumerisch"
            ],
            "additionalProperties": false,
            "properties": {
              "groesse": {
