            ""
          ]
        },
        "X2": {
          "enum": [
            "y",
            "n",
            ""
          ]
        },
        "X3": {
          "enum": [
            "y",
            "n",
            ""
          ]
        },
        "X4": {
          "enum": [
            "y",
            "n",
            ""
          ]
        }
      },
