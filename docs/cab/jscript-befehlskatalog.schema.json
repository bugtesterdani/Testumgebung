                  "null"
                ],
                "minimum": 0
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "level": {
                "type": "string"
              },
              "binaer": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "kanji": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "daten_codewoerter": {
                "type": "integer",
                "minimum": 0
              },
              "fehlerkorrektur_codewoerter": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "speicherarten": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/wert"
          }
        }
      },
      "required": [
        "id",
        "abschnitt",
        "art",
        "befehl",
        "titel",
        "seiten",
        "generationen",
        "verweis",
        "syntax",
        "parameter",
        "barcode_eigenschaften",
        "geprueft"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "geprueft": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "parameter": {
                "items": {
                  "properties": {
                    "beschreibung": {
                      "minLength": 1
                    },
                    "werte": {
                      "items": {
                        "properties": {
                          "beschreibung": {
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
