          "items": {
            "$ref": "#/definitions/wert"
          }
        },
        "bereich": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "standard": {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "object"
          ]
        },
        "generationen": {
          "$ref": "#/definitions/generationen"
