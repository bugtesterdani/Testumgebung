<Application x:Class="Testumgebung.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Testumgebung.Desktop.Converters"
             xmlns:vm="clr-namespace:Testumgebung.Presentation.ViewModels;assembly=Testumgebung.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:RatingToBrushConverter x:Key="RatingBrush" />
            <conv:RatingToTextConverter x:Key="RatingText" />
            <conv:RatingToGlyphConverter x:Key="RatingGlyph" />
            <conv:StatusKindToBrushConverter x:Key="StatusBrush" />
            <conv:ItemStateToGlyphConverter x:Key="StateGlyph" />
            <conv:ItemStateToBrushConverter x:Key="StateBrush" />
            <conv:NodeIconToGlyphConverter x:Key="NodeGlyph" />
            <conv:RunMarkerToBrushConverter x:Key="RunMarkerBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:EnumDisplayConverter x:Key="EnumDisplay" />
            <conv:DepthToMarginConverter x:Key="DepthMargin" />
            <conv:EnumToVisibilityConverter x:Key="PageVis" />
            <conv:PlotPointsConverter x:Key="PlotPoints" />
            <conv:SeriesBrushConverter x:Key="SeriesBrush" />
            <conv:ErrorBrushConverter x:Key="ErrorBrush" />
            <conv:BarHeightConverter x:Key="BarHeight" />

            <!-- Karte der Ablaufliste (Editor und Debugger) -->
            <HierarchicalDataTemplate x:Key="FlowNodeTemplate" DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                <Border x:Name="Card" Background="{Binding RunMarker, Converter={StaticResource RunMarkerBrush}}" CornerRadius="4" Padding="4,5" MinWidth="380">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Number}" MinWidth="46" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NodeIcon" Style="{StaticResource Icon}" Text="{Binding Icon, Converter={StaticResource NodeGlyph}}" Margin="0,0,10,0" />
                        <TextBlock x:Name="NodeName" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Annotation}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Ellipse Width="13" Height="13" Fill="{StaticResource FailBrush}" Stroke="White" StrokeThickness="2" Margin="12,0,0,0"
                                 ToolTip="Haltepunkt (vor Bewertungsrückgabe)"
                                 Visibility="{Binding HasBreakpoint, Converter={StaticResource BoolVis}}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource FailBrush}" FontSize="15" Margin="10,0,0,0"
                                   ToolTip="{Binding Diagnostic}" Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                        <Setter TargetName="NodeName" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSection}" Value="True">
                        <Setter TargetName="NodeName" Property="FontWeight" Value="Bold" />
                        <Setter TargetName="NodeName" Property="FontSize" Value="16" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExit}" Value="True">
                        <Setter TargetName="NodeName" Property="FontStyle" Value="Italic" />
                        <Setter TargetName="NodeIcon" Property="Foreground" Value="#B26A00" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <Style x:Key="FlowItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="AllowDrop" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
