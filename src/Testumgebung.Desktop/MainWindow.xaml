<Window x:Class="Testumgebung.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Testumgebung.Desktop.Views"
        Title="Testumgebung" Height="900" Width="1500" MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen" Icon="Assets/Testumgebung.ico"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================ Kopfzeile -->
        <DockPanel Grid.Row="0" Background="{StaticResource HeaderBrush}" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding AppTitle}" Foreground="White" FontSize="22" FontWeight="Bold" />
                <Rectangle Width="1" Height="24" Fill="#5C7FA8" Margin="16,0" />
                <TextBlock Text="{Binding ViewTitle}" Foreground="White" FontSize="20" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <ToggleButton x:Name="UserToggle" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Foreground="White" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding UserText}" Foreground="White" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=UserToggle}" PlacementTarget="{Binding ElementName=UserToggle}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource Card}" Width="300" Margin="0,6,0,0">
                        <StackPanel>
                            <!-- Nicht angemeldet -->
                            <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Anmelden" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding IsSimulatedLogin, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                           Text="Persönliches Firmenkonto (Microsoft Entra ID). Windows zeigt den Kontodialog; die Anwendung sieht kein Passwort." />
                                <StackPanel Visibility="{Binding IsSimulatedLogin, Converter={StaticResource BoolVis}}">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Text="Simulierte Anmeldung – keine Entra-App konfiguriert (Einstellungen → Zugang)." />
                                    <TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButton}" Content="Anmelden" Command="{Binding LoginCommand}"
                                        Visibility="{Binding CanEnableDevelopmentLogin, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                <Button Style="{StaticResource OutlineButton}" Content="Lokal anmelden (Entwicklungsmodus)" Margin="0,8,0,0"
                                        Command="{Binding DevelopmentLoginCommand}" Visibility="{Binding CanEnableDevelopmentLogin, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding LoginError}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding LoginError, Converter={StaticResource NullVis}}" />
                            </StackPanel>
                            <!-- Angemeldet -->
                            <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding UserText}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding UserDetail}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Abmelden entfernt die erweiterten Rechte. Laufende Prüfungen laufen weiter." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource OutlineButton}" Content="Firmenkonto wechseln" Command="{Binding SwitchAccountCommand}" Click="ClosePopup" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource OutlineButton}" Content="Abmelden" Command="{Binding LogoutCommand}" Click="ClosePopup" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Rectangle Width="1" Height="24" Fill="#5C7FA8" Margin="16,0" />
                <TextBlock x:Name="ClockText" Foreground="White" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- ============================================ Prüfplätze und Kontext -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,10" LastChildFill="False">
                <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,10,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Width="200" Padding="16,8" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{StaticResource BorderBrush}" Background="#FAFBFC">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="Bd" Property="Background" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="11" Height="11" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Rectangle DockPanel.Dock="Left" Width="1" Fill="{StaticResource BorderBrush}" Margin="16,4" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="28" Margin="0,0,12,0" Foreground="{StaticResource TextBrush}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Aktueller Prüfling" />
                        <TextBlock Text="{Binding SelectedStation.CurrentDutId}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
                <Rectangle DockPanel.Dock="Left" Width="1" Fill="{StaticResource BorderBrush}" Margin="16,4" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="28" Margin="0,0,12,0" Foreground="{StaticResource TextBrush}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Aktueller Auftrag" />
                        <TextBlock Text="{Binding SelectedStation.CurrentOrder}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
                <Rectangle DockPanel.Dock="Left" Width="1" Fill="{StaticResource BorderBrush}" Margin="16,4" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="28" Margin="0,0,12,0" Foreground="{StaticResource TextBrush}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Aktive Prüfsoftware" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveSoftwareText}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding ProjectName}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" MaxWidth="320"
                                   Text="{Binding SelectedStation.PendingVersionText}"
                                   Visibility="{Binding SelectedStation.PendingVersionText, Converter={StaticResource NullVis}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsDeveloper, Converter={StaticResource BoolVis}}">
                    <CheckBox Content="Entwurf testen" IsChecked="{Binding SelectedStation.UseDraft}" VerticalAlignment="Center" Margin="0,0,14,0"
                              Visibility="{Binding SelectedStation.UsesReleases, Converter={StaticResource BoolVis}}"
                              ToolTip="Aktuellen Editorstand statt der freigegebenen Version starten (Entwicklungslauf, nicht freigegeben)." />
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding StartSimulationCommand}" Padding="18,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,10,0" />
                            <TextBlock Text="Simulation starten" FontWeight="SemiBold" FontSize="16" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================ Navigation und Inhalt -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Operator, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Margin="0,0,12,0" />
                            <TextBlock Text="Prüfen" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Protocol, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Margin="0,0,12,0" />
                            <TextBlock Text="Protokoll" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Margin="0,22,0,0"
                                 Visibility="{Binding ShowReleasesNav, Converter={StaticResource BoolVis}}"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Releases, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,12,0" />
                            <TextBlock Text="Releases" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Visibility="{Binding CanSeeReports, Converter={StaticResource BoolVis}}"
                                 IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Reports, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Margin="0,0,12,0" />
                            <TextBlock Text="Auswertung" />
                        </StackPanel>
                    </RadioButton>
                    <StackPanel Visibility="{Binding IsDeveloper, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Entwicklung" FontWeight="SemiBold" FontSize="16" Margin="12,22,0,8" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Editor, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,12,0" />
                                <TextBlock Text="Ablaufeditor" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Library, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" Margin="0,0,12,0" />
                                <TextBlock Text="CodeBlocks" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Curves, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Margin="0,0,12,0" />
                                <TextBlock Text="Kurven" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Stations, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,12,0" />
                                <TextBlock Text="Prüfplatzkonfiguration" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Selection, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" Margin="0,0,12,0" />
                                <TextBlock Text="Auswahl &amp; Auftrag" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Results, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" Margin="0,0,12,0" />
                                <TextBlock Text="Ergebnisse" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Debug, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEBE8;" Margin="0,0,12,0" />
                                <TextBlock Text="Debug" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=System, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" Margin="0,0,12,0" />
                                <TextBlock Text="System &amp; Sicherung" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Visibility="{Binding HasSettings, Converter={StaticResource BoolVis}}"
                                     IsChecked="{Binding Page, Converter={StaticResource EnumEquals}, ConverterParameter=Settings, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,12,0" />
                                <TextBlock Text="Einstellungen" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Operator}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <views:OperatorView Grid.Row="1" />
                    <views:PairedStationsView Grid.Row="1" Visibility="{Binding PairedStations.Enabled, Converter={StaticResource BoolVis}}"/>
                </Grid>
                <views:ProtocolView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Protocol}" />
                <views:DevelopmentWorkspace Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Editor}" />
                <views:DebugView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Debug}" />
                <views:LibraryView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Library}" />
                <views:ResultsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Results}" />
                <views:SettingsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Settings}" />
                <views:ReleasesView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Releases}" />
                <views:CurvesView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Curves}" />
                <views:StationsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Stations}" />
                <views:SelectionView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Selection}" />
                <views:SystemView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=System}" />
                <views:ReportsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Reports}" />

                <!-- Große Werkerwarnung: DB-Speicherung am Testende gescheitert (10 s je betroffenem Run, alle Prüfplätze) -->
                <ItemsControl ItemsSource="{Binding Stations}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" IsHitTestVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding StorageWarnings}" Tag="{Binding Name}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource WarnBrush}" CornerRadius="8" Padding="26,18" Margin="0,0,0,12" MaxWidth="900">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="White" FontSize="40" Margin="0,0,20,0" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap">
                                                        <Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" /><Run Text=": Datenbank nicht erreicht" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="White" Opacity="0.85" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- ============================================ Statusleiste mit Start und Werkerabbruch (immer sichtbar) -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding PairedStations.Enabled, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SelectedStation.StartCommand}" Width="300" Height="56" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="22" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="Start" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Text="während Prüfung deaktiviert"
                                           Visibility="{Binding SelectedStation.IsRunning, Converter={StaticResource BoolVis}}" />
                                <TextBlock FontSize="12" Text="bereit für Prüfung"
                                           Visibility="{Binding SelectedStation.IsRunning, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding SelectedStation.AbortCommand}" Width="260" Height="56">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{StaticResource FailBrush}" Margin="0,0,16,0" />
                                <TextBlock Text="Werkerabbruch" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                   Text="Erneuter Abbruch beendet nur die aktuelle Exit-Gruppe."
                                   Visibility="{Binding SelectedStation.IsAborting, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource PrimaryBrush}" Margin="0,0,16,0">
                        <TextBlock Text="i" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SelectedStation.Name, Mode=OneWay}" />
                            <Run Text="  •  Prüfling " />
                            <Run Text="{Binding SelectedStation.CurrentDutId, Mode=OneWay}" />
                            <Run Text="  •  " />
                            <Run Text="{Binding SelectedStation.ProgressText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedStation.Hint}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedStation.Error}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding SelectedStation.Error, Converter={StaticResource NullVis}}" />
                        <TextBlock Text="{Binding SelectedStation.StorageError}" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedStation.StorageError, Converter={StaticResource NullVis}}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
