<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Testumgebung.Desktop</RootNamespace>
    <AssemblyTitle>Testumgebung</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Testumgebung.ico</ApplicationIcon>
    <!-- Generierter WPF-Code soll den Build nicht an Warnungen scheitern lassen -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Testumgebung.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <ProjectReference Include="..\Testumgebung.Presentation\Testumgebung.Presentation.csproj" />
    <ProjectReference Include="..\Testumgebung.Workers\Testumgebung.Workers.csproj" />
  </ItemGroup>
  <!-- Datenbanktreiber (Etappe 6). Der Adapter selbst nutzt nur ADO.NET; hier werden die Provider eingebunden. -->
  <ItemGroup>
    <None Include="../../licenses/third-party/microsoft/*" Link="licenses/third-party/microsoft/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/oeffentliche-veroeffentlichung.md" Link="docs/oeffentliche-veroeffentlichung.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/datenschutz.md" Link="docs/datenschutz.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-TERMS.md" Link="THIRD-PARTY-TERMS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Managed networking only: native SNI has separate redistribution terms. -->
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" Version="7.1.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Entra-Anmeldung über MSAL im Systembrowser -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <!-- OPC-UA-Meldeweg (OPC Foundation .NET Standard Stack) -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="2.0.1" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="2.0.1" />
    <!-- DPAPI für Verbindungsstrings und Passwörter stellt net10.0-windows bereit. -->
  </ItemGroup>
  <!-- C#- und Python-Worker nach bin\...\workers\ kopieren -->
  <Import Project="..\..\build\CodeWorkers.targets" />
  <ItemGroup>
    <Content Include="../../docs/ki-testprogramme.md" Link="docs/ki-testprogramme.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/ki/**/*" Link="docs/ki/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/beispiele/prozess-demo.py" Link="docs/beispiele/prozess-demo.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/beispiele/*.md" Link="docs/beispiele/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\beispiele\*.tproj.json" Link="docs\beispiele\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
