<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <HierarchicalDataTemplate x:Key="VisualBlockTemplate" ItemsSource="{Binding Children}">
        <Grid Margin="0,0,0,2">
            <Border x:Name="Card" Background="{Binding BlockColor}" CornerRadius="7" Padding="10,9" Margin="0,5,0,0" MinWidth="280" BorderThickness="2" BorderBrush="Transparent">
                <StackPanel>
                    <DockPanel>
                        <Button Style="{StaticResource ToolButton}" DockPanel.Dock="Right" Content="Werte …" Padding="6,2" Margin="12,0,0,0" Background="White" BorderThickness="0"
                                Command="{Binding DataContext.Editor.SelectBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Number}" FontSize="12" Foreground="#526177" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="deaktiviert" Visibility="{Binding IsInactive, Converter={StaticResource BoolVis}}" Margin="8,0,0,0"/>
                            <Ellipse Fill="#CF3030" Width="10" Height="10" Margin="8,0,0,0" Visibility="{Binding HasBreakpoint, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ParameterSummary}" TextWrapping="Wrap" MaxWidth="340" FontSize="12" Foreground="#34435A" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" MaxWidth="340" FontSize="12" Foreground="#43516A" Margin="0,4,0,0" Visibility="{Binding HasComment, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" MaxWidth="340" Foreground="#AD211E" Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Border>
            <Path Data="M 0,6 L 6,0 L 28,0 L 34,6 Z" Fill="{Binding BlockColor}" Width="34" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,0,0,0" IsHitTestVisible="False"/>
        </Grid>
        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#175DCE"/></DataTrigger>
            <DataTrigger Binding="{Binding IsInactive}" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.55"/></DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
    <Style x:Key="VisualBlockItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource FlowItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="TreeViewItem">
                <Grid Margin="0,0,0,3">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <ToggleButton x:Name="Fold" DockPanel.Dock="Left" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="22" Height="24" Margin="0,7,4,0" VerticalAlignment="Top" AutomationProperties.Name="Gruppe auf- oder zuklappen">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="FoldBorder" Background="#F3F6FA" BorderBrush="#C7D1DE" BorderThickness="1" CornerRadius="4">
                                    <TextBlock x:Name="FoldText" Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#46566D"/>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="FoldText" Property="Text" Value="−"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FoldBorder" Property="BorderBrush" Value="#175DCE"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </DockPanel>
                    <Border x:Name="BodyRail" Grid.Row="1" BorderBrush="{Binding BlockColor}" BorderThickness="12,0,0,0" Margin="30,0,0,0" Padding="8,0,0,0">
                        <Grid><ItemsPresenter x:Name="ItemsHost"/>
                            <Border x:Name="EmptySlot" Padding="12,9" Margin="4" BorderBrush="#B5C3D3" BorderThickness="1" CornerRadius="5" Background="#F7FAFD" Visibility="Collapsed">
                                <TextBlock Text="Blöcke in die Gruppenmitte ziehen oder aus der Palette anklicken" Foreground="#66768B" FontSize="12" TextWrapping="Wrap" MaxWidth="320"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="Foot" Grid.Row="2" Background="{Binding BlockColor}" Height="10" Margin="30,0,10,0" CornerRadius="0,0,5,5"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/><Setter TargetName="EmptySlot" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="BodyRail" Property="Visibility" Value="Collapsed"/><Setter TargetName="Foot" Property="Visibility" Value="Collapsed"/></Trigger>
                    <DataTrigger Binding="{Binding IsGroup}" Value="False"><Setter TargetName="BodyRail" Property="Visibility" Value="Collapsed"/><Setter TargetName="Foot" Property="Visibility" Value="Collapsed"/><Setter TargetName="Fold" Property="Visibility" Value="Hidden"/></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>