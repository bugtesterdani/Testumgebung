<Window x:Class="Testumgebung.Desktop.Views.ContextHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hilfe" Width="760" Height="640" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <Button DockPanel.Dock="Bottom" Content="Schließen" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <StackPanel Visibility="{Binding Block, Converter={StaticResource NullVis}}" Margin="0,0,0,14">
                    <TextBlock Text="{Binding Block.DisplayName}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Block.Description}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding Block.Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,5">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Visibility="{Binding Hint, Converter={StaticResource NullVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding Topic.Heading}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                <TextBox Text="{Binding Section, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Padding="0" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
