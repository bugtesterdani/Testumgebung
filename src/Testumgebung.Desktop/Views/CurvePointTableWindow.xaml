<Window x:Class="Testumgebung.Desktop.Views.CurvePointTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurvenpunkte bearbeiten" Width="680" Height="620" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <Label DockPanel.Dock="Left" Content="_Linie" Target="{Binding ElementName=Lines}" Margin="0,0,8,0" />
            <ComboBox x:Name="Lines" DisplayMemberPath="Label" SelectionChanged="SelectLine" />
        </DockPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Zeit und Wert in der Tabelle bearbeiten. Neue Zeiten werden beim Übernehmen sortiert. Andere Linien behalten ihren Verlauf. Ihre Zeitpunkte können in der bearbeiteten Linie als interpolierte Werte sichtbar bleiben." />

        <DataGrid x:Name="Points" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  AutomationProperties.Name="Kurvenpunkte der ausgewählten Linie">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Punkt" Binding="{Binding Number}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="Zeit [s]" Binding="{Binding Time}" Width="*" />
                <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Punkt hinzufügen" Click="AddPoint" />
            <Button Content="Punkt entfernen" Click="RemovePoint">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=Points}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>

        <WrapPanel Grid.Row="4" Margin="0,6,0,0">
            <Button x:Name="Previous" Style="{StaticResource ToolButton}" Content="Zurück" Click="PreviousPage" />
            <Button x:Name="Next" Style="{StaticResource ToolButton}" Content="Weiter" Click="NextPage" />
            <Label Content="_Seite" Target="{Binding ElementName=PageInput}" VerticalAlignment="Center" />
            <TextBox x:Name="PageInput" Width="64" VerticalContentAlignment="Center" />
            <TextBlock x:Name="PageTotal" VerticalAlignment="Center" Margin="6,0" />
            <Button Style="{StaticResource ToolButton}" Content="Öffnen" Click="JumpPage" />
        </WrapPanel>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource OutlineButton}" Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Übernehmen" Click="Apply" />
            </StackPanel>
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
