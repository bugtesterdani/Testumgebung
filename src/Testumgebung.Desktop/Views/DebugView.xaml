<UserControl x:Class="Testumgebung.Desktop.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Debugger (Abbildung 8): Pause vor Bewertungsrückgabe, Variablen, gezielte Ausführung -->
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding SelectedStation.Debug.ContinueCommand}" />
        <KeyBinding Key="F10" Command="{Binding SelectedStation.Debug.StepOverCommand}" />
        <KeyBinding Key="F11" Command="{Binding SelectedStation.Debug.StepIntoCommand}" />
        <KeyBinding Key="F11" Modifiers="Shift" Command="{Binding SelectedStation.Debug.StepOutCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="420" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="embedded">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Ablauf mit Laufmarkierung -->
        <Border Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="4,0,0,6">
                    <Run Text="Ablauf – " /><Run Text="{Binding SelectedStation.Name, Mode=OneWay}" />
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0,0,8"
                           Text="Haltepunkte im Ablaufeditor setzen (F9). Blau = läuft, rot = pausiert." />
                <TreeView Style="{StaticResource FlowTree}" FontSize="14" ItemsSource="{Binding Editor.Nodes}"
                          ItemTemplate="{StaticResource FlowNodeTemplate}" ItemContainerStyle="{StaticResource FlowItemStyle}" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding SelectedStation.Debug}">

                <!-- Kopf -->
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}" Width="190" Height="46" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="White" Margin="0,0,10,0" />
                                <TextBlock Text="Fortsetzen" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding RerunCommand}" Width="190" Height="46">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,10,0" />
                                <TextBlock Text="Erneut ausführen" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="10,0,0,0">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding StepIntoCommand}" Content="Einzelschritt (F11)" HorizontalContentAlignment="Left"
                                    ToolTip="Fortsetzen und nach dem nächsten ausgeführten Element anhalten – auch innerhalb von Gruppen" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding StepOverCommand}" Content="Prozedurschritt (F10)" HorizontalContentAlignment="Left"
                                    ToolTip="Nach dem nächsten Element derselben oder einer äußeren Ebene anhalten" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding StepOutCommand}" Content="Bis Gruppenende (⇧F11)" HorizontalContentAlignment="Left"
                                    ToolTip="Umgebende Gruppe fertig ausführen (inkl. Exit) und vor deren Bewertungsrückgabe anhalten" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource FailBrush}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource PageTitle}" FontSize="26" Text="Pausiert vor Bewertungsrückgabe" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" FontSize="26" Text="Kein Haltepunkt erreicht"
                                   Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Breadcrumb}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="  ›  " FontSize="16" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PositionText}" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource InfoBox}" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap"
                               Text="Haltepunkte liegen nach der Ausführung und vor der Bewertungsrückgabe: Ausgänge und Hardwareaktionen sind bereits wirksam. Erneut ausführen ersetzt die ausstehende Bewertung – keine doppelte Übernahme." />
                </Border>

                <!-- Bewertungskarten -->
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"
                        Visibility="{Binding IsCodePaused, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CodePositionText}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding CodeCapabilityText}" Margin="0,4,0,8" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Code fortsetzen" Command="{Binding CodeContinueCommand}" Margin="0,0,8,0" />
                            <Button Content="Nächste Codezeile" Command="{Binding CodeStepCommand}" Margin="0,0,8,0" />
                            <Button Content="Code abbrechen" Command="{Binding CodeStopCommand}" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding CodeVariables}" IsReadOnly="True" MaxHeight="280" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Variable / Diagnose" Binding="{Binding Name}" Width="220" />
                                <DataGridTemplateColumn Header="Wert / Callstack" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,12" Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ausgänge bereits wirksam" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OutputText}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource FailLightBrush}">
                        <StackPanel>
                            <TextBlock Text="Ausstehende Bewertung" FontWeight="SemiBold" Foreground="{StaticResource FailBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Icon}" FontSize="24" Margin="0,0,10,0"
                                           Text="{Binding PendingRating, Converter={StaticResource RatingGlyph}}"
                                           Foreground="{Binding PendingRating, Converter={StaticResource RatingBrush}}" />
                                <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding PendingRating, Converter={StaticResource RatingText}}"
                                           Foreground="{Binding PendingRating, Converter={StaticResource RatingBrush}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Elternbewertung" FontWeight="SemiBold" />
                            <TextBlock FontSize="24" FontWeight="Bold" Margin="0,8,0,0" Text="{Binding ParentRating, Converter={StaticResource RatingText}}"
                                       Foreground="{Binding ParentRating, Converter={StaticResource RatingBrush}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Variablen und Schnappschuss -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Variablen (aktueller Kontext)" />
                            <DataGrid ItemsSource="{Binding Variables}" MinHeight="120" MaxHeight="340" RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Wert (Enter übernimmt)" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" LostFocus="OnValueLostFocus">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding CommitCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="70" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Herkunftsgruppe" Binding="{Binding Origin}" Width="1.3*" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Status" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Error, Converter={StaticResource NullVis}}" Value="Visible">
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource FailBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Änderungen werden typgeprüft, protokolliert und markieren den Lauf als Entwicklungslauf. ../Name zeigt verdeckte äußere Variablen." />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Debug-Schnappschuss" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="14" Margin="8,0,0,8" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Lokale Variablen der verlassenen Gruppe – kein aktiver Scope." TextWrapping="Wrap" Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding Snapshot}" IsReadOnly="True" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" />
                                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Gezielte Ausführung" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Schritt im Ablaufeditor wählen. Ein Schritt läuft unabhängig von Gruppenbedingungen; eine Gruppe nur bei erfüllter Bedingung. Nur ohne laufenden Test." />
                                <TextBlock Text="Fehlender Kontext (optional)" Margin="0,4,0,4" />
                                <TextBox Text="{Binding ContextText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}"
                                         ToolTip="z. B. Spannung = 249.0; Kennung = &quot;SN-1&quot;" />
                                <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding DataContext.ExecuteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Auswahl ausführen" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding TargetResult}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Run-Patch: Code/Parameter noch nicht ausgeführter Elemente -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding Patch}"
                        Visibility="{Binding DataContext.IsPaused, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center">
                                <Run Text="Run-Patches: " /><Run Text="{Binding PatchCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="Run-Patch – " /><Run Text="{Binding Title, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Element im Ablauf wählen. Änderungen gelten nur für diesen Lauf (nicht für den Entwurf), werden geprüft und protokolliert. Aktive Gruppen sind gesperrt; bereits ausgeführte Schritte werden nicht wiederholt." />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Label" Style="{StaticResource Label}" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,6,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsText, Converter={StaticResource BoolVis}}" />
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolVis}}" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}"
                                                     AcceptsReturn="True" AcceptsTab="True" MinHeight="140" MaxHeight="320" VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                                     Visibility="{Binding IsCode, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                            <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource OutlineButton}" Command="{Binding ValidateCommand}" Content="Patch prüfen" Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Content="Änderungen übernehmen" />
                        </StackPanel>
                        <TextBlock x:Name="PatchStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Entwicklungsprotokoll -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Entwicklereingriffe" />
                        <DataGrid ItemsSource="{Binding DevelopmentLog}" IsReadOnly="True" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="80" />
                                <DataGridTextColumn Header="Benutzer" Binding="{Binding User}" Width="120" />
                                <DataGridTextColumn Header="Ereignis" Binding="{Binding Kind}" Width="180" />
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
