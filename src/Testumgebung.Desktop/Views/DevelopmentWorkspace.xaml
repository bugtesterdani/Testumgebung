<UserControl x:Class="Testumgebung.Desktop.Views.DevelopmentWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Testumgebung.Desktop.Views" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="200" />
            <RowDefinition Height="6" />
            <RowDefinition Height="2*" MinHeight="140" />
        </Grid.RowDefinitions>
        <views:EditorView />
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
        <TabControl Grid.Row="2" Margin="16,0,16,8" SelectedIndex="{Binding WorkspaceToolTab}">
            <TabItem Header="Protokoll">
                <views:ProtocolGrid DataContext="{Binding SelectedStation}" />
            </TabItem>
            <TabItem Header="Variablen">
                <DockPanel Margin="10" DataContext="{Binding SelectedStation.Debug}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PositionText}" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding Variables}" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Wert" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Übernehmen" Command="{Binding CommitCommand}" />
                                            <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Herkunft" Binding="{Binding Origin}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Debug">
                <views:DebugView Tag="embedded" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
