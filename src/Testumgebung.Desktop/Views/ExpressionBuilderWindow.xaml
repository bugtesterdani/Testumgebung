<Window x:Class="Testumgebung.Desktop.Views.ExpressionBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Testumgebung.Presentation.ViewModels;assembly=Testumgebung.Presentation"
        Width="1100" Height="720" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}"/>
        <DataTemplate DataType="{x:Type vm:VisualExpressionNode}">
            <Border Background="{Binding Color}" CornerRadius="12" Padding="8" Margin="4" MinWidth="110"
                    AllowDrop="True" DragOver="OnBlockDragOver" Drop="OnBlockDrop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#9BAFC2"/><Setter Property="BorderThickness" Value="2"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#1359C9"/><Setter Property="BorderThickness" Value="3"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TypeText}" Foreground="#43516A" FontSize="11" Margin="8,0,0,0"/>
                        <Button Content="{Binding Label}" Click="OnSelectNode" Background="Transparent" BorderThickness="0" Padding="3"
                                HorizontalAlignment="Left" PreviewMouseLeftButtonDown="OnNodeMouseDown" MouseMove="OnNodeMouseMove"/>
                    </DockPanel>
                    <WrapPanel>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="65" MaxWidth="220"
                                 Visibility="{Binding IsNumber, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Zahlenblock"/>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="100" MaxWidth="260" MaxHeight="100"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsText, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Textblock"/>
                        <CheckBox Content="Ja (aus = Nein)" IsChecked="{Binding BooleanValue}"
                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolVis}}"/>
                        <ComboBox ItemsSource="{Binding Owner.Variables}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding VariableChoice}" IsSynchronizedWithCurrentItem="False" MinWidth="180" MaxWidth="340"
                                  Visibility="{Binding IsVariable, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Ausdrucksvariable"/>
                        <ContentControl Content="{Binding Left}" Visibility="{Binding HasLeft, Converter={StaticResource BoolVis}}"/>
                        <ContentControl Content="{Binding Right}" Visibility="{Binding HasRight, Converter={StaticResource BoolVis}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Ausdruck aus Blöcken bauen" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Steckplatz anklicken, dann einen Block einsetzen oder hineinziehen. Mit ↶ umschließt ein Operator die Auswahl. Vorhandene Blöcke lassen sich ziehen; Strg zieht eine Kopie." TextWrapping="Wrap" Style="{StaticResource Caption}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Palette}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,4"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="↶" ToolTip="Um ausgewählten Ausdruck legen"
                                                Visibility="{Binding IsOperator, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.WrapCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <Button Content="{Binding Label}" Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" PreviewMouseLeftButtonDown="OnTileMouseDown" MouseMove="OnTileMouseMove"
                                                HorizontalContentAlignment="Left" ToolTip="In ausgewählten Steckplatz einsetzen oder ziehen"/>
                                    </DockPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Column="2" BorderBrush="#CCD5E1" BorderThickness="1" Background="#F6F9FC" CornerRadius="6">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="8">
                        <Button Content="Rückgängig" Command="{Binding UndoCommand}"/>
                        <Button Content="Wiederholen" Command="{Binding RedoCommand}" Margin="6,0"/>
                        <Button Content="Ausgewählten Block entfernen" Command="{Binding DeleteCommand}"/>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding Root}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,6">
            <TextBlock Text="Vorschau (wird erst beim Übernehmen gespeichert)" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Source, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="75" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="{Binding ResultType, StringFormat='Ergebnistyp: {0}'}" Style="{StaticResource Caption}" Margin="0,3"/>
            <TextBlock Text="{Binding Notice}" Foreground="#85580D" TextWrapping="Wrap"/>
            <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DialogError" Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap"/></ScrollViewer>
            <Expander Header="Vorhandenen Ausdruck ansehen"><TextBox Text="{Binding Original, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="65" VerticalScrollBarVisibility="Auto"/></Expander>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Leer / Standard" Click="OnClear" Visibility="{Binding AllowEmpty, Converter={StaticResource BoolVis}}" Margin="0,0,8,0"/>
            <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Übernehmen" IsEnabled="{Binding CanApply}" Click="OnApply" Style="{StaticResource PrimaryButton}"/>
        </WrapPanel>
    </Grid>
</Window>