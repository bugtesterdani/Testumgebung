<UserControl x:Class="Testumgebung.Desktop.Views.InlineExpressionEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:Testumgebung.Presentation.ViewModels;assembly=Testumgebung.Presentation">
 <UserControl.Resources>
 <Style TargetType="Button" BasedOn="{StaticResource ToolButton}"/>
        <DataTemplate DataType="{x:Type vm:VisualExpressionNode}">
            <Border Background="{Binding Color}" CornerRadius="12" Padding="8" Margin="4" MinWidth="110"
                    AllowDrop="True" DragOver="OnBlockDragOver" Drop="OnBlockDrop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#9BAFC2"/><Setter Property="BorderThickness" Value="2"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#1359C9"/><Setter Property="BorderThickness" Value="3"/></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TypeText}" Foreground="#43516A" FontSize="11" Margin="8,0,0,0"/>
                        <Button Content="{Binding Label}" Click="OnSelectNode" Background="Transparent" BorderThickness="0" Padding="3"
                                HorizontalAlignment="Left" PreviewMouseLeftButtonDown="OnNodeMouseDown" MouseMove="OnNodeMouseMove"/>
                    </DockPanel>
                    <WrapPanel>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="65" MaxWidth="220"
                                 Visibility="{Binding IsNumber, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Zahlenblock"/>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MinWidth="100" MaxWidth="260" MaxHeight="100"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsText, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Textblock"/>
                        <CheckBox Content="Ja (aus = Nein)" IsChecked="{Binding BooleanValue}"
                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolVis}}"/>
                        <ComboBox ItemsSource="{Binding Owner.Variables}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding VariableChoice}" IsSynchronizedWithCurrentItem="False" MinWidth="180" MaxWidth="340"
                                  Visibility="{Binding IsVariable, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Ausdrucksvariable"/>
                        <ContentControl Content="{Binding Left}" Visibility="{Binding HasLeft, Converter={StaticResource BoolVis}}"/>
                        <ContentControl Content="{Binding Right}" Visibility="{Binding HasRight, Converter={StaticResource BoolVis}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
 </UserControl.Resources>
 <Border Background="#F8FAFF" CornerRadius="8" BorderBrush="#B9CBE4" BorderThickness="1" Padding="10" MaxWidth="960">
 <StackPanel>
 <TextBlock Text="1. Steckplatz wählen   2. Block einsetzen   3. Übernehmen" FontWeight="SemiBold" Margin="0,0,0,6"/>
 <ItemsControl ItemsSource="{Binding Palette}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,14,8">
 <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#53657D"/>
 <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
 <Button Content="{Binding Label}" Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
 <Button Content="↶" ToolTip="Um die Auswahl legen" Visibility="{Binding IsOperator, Converter={StaticResource BoolVis}}" Command="{Binding DataContext.WrapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
 </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="350"><ContentControl Content="{Binding Root}" HorizontalAlignment="Left"/></ScrollViewer>
 <TextBlock Text="{Binding Source}" TextWrapping="Wrap" FontFamily="Consolas" Margin="2,6"/>
 <TextBlock Text="{Binding ResultType, StringFormat='Ergebnis: {0}'}" FontSize="12"/>
 <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#85580D"/>
 <TextBlock x:Name="DialogError" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#B42318"/>
 <WrapPanel Margin="0,6,0,0">
 <Button Content="Rückgängig" Command="{Binding UndoCommand}"/>
 <Button Content="Wiederholen" Command="{Binding RedoCommand}"/>
 <Button Content="Entfernen" Command="{Binding DeleteCommand}"/>
 <Button Content="Leer / Standard" Click="OnClear" Visibility="{Binding AllowEmpty, Converter={StaticResource BoolVis}}"/>
 <Button Content="Abbrechen" Click="OnCancel"/>
 <Button Content="Übernehmen" Click="OnApply" IsEnabled="{Binding CanApply}" Style="{StaticResource PrimaryButton}"/>
 </WrapPanel>
 </StackPanel></Border>
</UserControl>
