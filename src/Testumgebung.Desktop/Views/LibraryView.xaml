<UserControl x:Class="Testumgebung.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Testumgebung.Presentation.ViewModels;assembly=Testumgebung.Presentation">
    <!-- Baustein-Bibliothek (Abbildung 2): Liste | Code | Schnittstelle -->
    <Grid Margin="16" DataContext="{Binding Library}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="560" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Bibliothek -->
        <Border Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Baustein-Bibliothek" Margin="4,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text=".NET-DLLs dieses Projekts" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding Assemblies}" SelectedItem="{Binding SelectedAssembly}" DisplayMemberPath="Name" MaxHeight="110" />
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding ImportAssemblyCommand}" Content=".NET-DLL importieren / ersetzen" Margin="0,6,0,6" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RemoveAssemblyCommand}" Content="Ausgewählte DLL entfernen" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource ErrorText}" Margin="0,0,0,6"
                               Visibility="{Binding Message, Converter={StaticResource NullVis}}" />
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding AddCSharpCommand}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="C#-Baustein" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding AddPythonCommand}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Python-Baustein" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding AddCppCommand}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="C++-Baustein" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding AddLabViewCommand}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="LabVIEW-Baustein (Prototyp)" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Löschen" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="CodeBlocks werden über „In Baustein umwandeln“, Gruppen über „Aus Gruppe erstellen“ (Gruppeneigenschaften) in die Bibliothek übernommen." />
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,6">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" />
                                    <TextBlock Text="{Binding Language}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================== Code -->
        <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Selected}"
                Visibility="{Binding Converter={StaticResource NullVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenInLabViewCommand}" Margin="0,0,10,0"
                                Visibility="{Binding IsLabView, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="In LabVIEW öffnen" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Command="{Binding BuildCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Build prüfen" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding TestCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="Test ausführen" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" MinWidth="220" BorderThickness="0,0,0,1" />
                        <TextBlock Text="v" FontSize="18" VerticalAlignment="Center" Margin="12,0,2,0" />
                        <TextBox Text="{Binding Version}" Width="60" FontSize="16" BorderThickness="0,0,0,1" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="110" Margin="14,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,8" CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F4F6F9" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuildOk}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PassLightBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BuildOk}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource FailLightBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding BuildStatus}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding RuntimeInfo}" Style="{StaticResource Caption}" />
                        <ItemsControl ItemsSource="{Binding Diagnostics}" MaxHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Diag" Text="{Binding}" TextWrapping="Wrap" FontFamily="{StaticResource CodeFont}" FontSize="12" Foreground="#8A5A00" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="Diag" Property="Foreground" Value="{StaticResource FailBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ApiHelp}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged, Delay=500}" Style="{StaticResource CodeBox}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- ============================== Schnittstelle -->
        <Border Grid.Column="4" Style="{StaticResource Card}" DataContext="{Binding Selected}"
                Visibility="{Binding Converter={StaticResource NullVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}">
                        <Run Text="Schnittstelle" /><Run Text=" (Baustein-Vertrag)" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding Ports}" RowHeight="32" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Bezeichnung" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Typ" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:PortRowViewModel.Types}" SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,2">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Richtung" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:PortRowViewModel.Directions}" SelectedItem="{Binding Direction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,2">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Einheit" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Testwert" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TestValue, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Beschreibung" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolButton}" Margin="0" Padding="4,1" ToolTip="Port entfernen"
                                                Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ItemsControl ItemsSource="{Binding Ports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource NullVis}}">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Error, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding AddPortCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Port hinzufügen" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource InfoBox}" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Bausteingrenze: kein impliziter Zugriff auf äußere Variablen. Ports sind im Code Felder (C#) bzw. lokale Namen (Python)." />
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Beschreibung" Margin="0,14,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Testausführung" Margin="0,14,0,6" />
                    <TextBlock Style="{StaticResource Caption}" Text="Mit den Testwerten der Eingänge, Hardware aus der Simulation des Projekts." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Aufruf-ID: " Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding InvocationId}" FontFamily="{StaticResource CodeFont}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TestResult}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding TestLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Verwendet in" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding UsedIn}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================== Grafischer Baustein: Übersicht -->
        <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding SelectedGroup}"
                Visibility="{Binding Converter={StaticResource NullVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" MinWidth="220" BorderThickness="0,0,0,1" />
                    <TextBlock Text="v" FontSize="18" VerticalAlignment="Center" Margin="12,0,2,0" />
                    <TextBox Text="{Binding Version}" Width="60" FontSize="16" BorderThickness="0,0,0,1" />
                    <TextBlock Text="Grafischer Baustein" Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Beschreibung" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenInEditorCommand}" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="Körper im Ablaufeditor bearbeiten" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Der Körper erscheint im Ablaufeditor als eigener Abschnitt unter dem Hauptablauf. Werkerabbruch, Exit-Gruppen und Haltepunkte gelten darin wie im Hauptablauf." />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Struktur" FontWeight="SemiBold" Margin="0,4,0,4" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Structure}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource CodeFont}" FontSize="13" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================== Grafischer Baustein: Schnittstelle -->
        <Border Grid.Column="4" Style="{StaticResource Card}" DataContext="{Binding SelectedGroup}"
                Visibility="{Binding Converter={StaticResource NullVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}">
                        <Run Text="Schnittstelle" /><Run Text=" (Ports = Variablen des Körpers)" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding Ports}" RowHeight="32" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Bezeichnung" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Typ" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:PortRowViewModel.Types}" SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,2">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Richtung" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{x:Static vm:PortRowViewModel.Directions}" SelectedItem="{Binding Direction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4,2">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Einheit" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Testwert" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TestValue, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Beschreibung" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolButton}" Margin="0" Padding="4,1" ToolTip="Port entfernen"
                                                Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ItemsControl ItemsSource="{Binding Ports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource NullVis}}">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Error, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding AddPortCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Port hinzufügen" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InfoBox}" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Bausteingrenze: Der Körper sieht nur seine Ports und eigenen Variablen, keine Variablen des aufrufenden Ablaufs." />
                    </Border>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Verwendet in" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding UsedIn}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
