<UserControl x:Class="Testumgebung.Desktop.Views.LiveOutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl ItemsSource="{Binding LiveOutputs.Items}" Visibility="{Binding LiveOutputs.HasContent, Converter={StaticResource BoolVis}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                        </DockPanel>
                        <ProgressBar Value="{Binding Value, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Maximum="100" Height="7" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextChanged="OutputChanged" FontFamily="Consolas" FontSize="12"
                                 Height="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Live-Prozessausgabe"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
