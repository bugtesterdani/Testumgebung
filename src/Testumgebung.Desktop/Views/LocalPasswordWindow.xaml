<Window x:Class="Testumgebung.Desktop.Views.LocalPasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Lokales Passwort setzen" Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="White">
 <StackPanel Margin="20">
  <TextBlock x:Name="Account" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock Text="Neues Passwort"/><PasswordBox x:Name="NewPassword" MaxLength="1024" Margin="0,4,0,10" AutomationProperties.Name="Neues Passwort"/>
  <TextBlock Text="Passwort wiederholen"/><PasswordBox x:Name="Confirmation" MaxLength="1024" Margin="0,4,0,10" AutomationProperties.Name="Passwort wiederholen"/>
  <TextBlock x:Name="Error" Foreground="Firebrick" TextWrapping="Wrap"/>
  <TextBlock Text="Wird erst mit Zugang speichern übernommen." TextWrapping="Wrap" Margin="0,8"/>
  <WrapPanel HorizontalAlignment="Right"><Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0"/><Button Content="Übernehmen" IsDefault="True" Click="OnApply"/></WrapPanel>
 </StackPanel>
</Window>
