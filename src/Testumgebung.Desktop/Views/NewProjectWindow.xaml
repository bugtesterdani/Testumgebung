<Window x:Class="Testumgebung.Desktop.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neues Prüfprogramm" Width="630" Height="510" MinWidth="520" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Label Target="{Binding ElementName=ProjectName}" Content="_Projektname" Padding="0" FontWeight="SemiBold" />
            <TextBox x:Name="ProjectName" Text="Neues Prüfprogramm" Margin="0,6,0,4" />
            <TextBlock x:Name="ValidationMessage" Style="{StaticResource Caption}" Foreground="{StaticResource FailBrush}" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Prüfprogramm erstellen" IsDefault="True" Click="OnCreate" Style="{StaticResource PrimaryButton}" />
            </WrapPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Vorlage wählen" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <ListBox x:Name="Templates" AutomationProperties.Name="Projektvorlage">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6" MaxWidth="460">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
