<UserControl x:Class="Testumgebung.Desktop.Views.OperatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Testumgebung.Desktop.Views"
             xmlns:beh="clr-namespace:Testumgebung.Desktop.Behaviors">
    <!-- Werkeransicht eines Prüfplatzes (Abbildungen 7, 11, 13) -->
    <Grid DataContext="{Binding SelectedStation}" Margin="16" Visibility="{Binding DataContext.PairedStations.Enabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="12" />
            <RowDefinition Height="250" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Ablaufübersicht (Layout des Ablaufs: ein-/ausblendbar, Fortschritt links/oben/unten) -->
        <Border Style="{StaticResource Card}" Grid.RowSpan="{Binding MainRowSpan}" Visibility="{Binding ShowOverview, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Ablaufübersicht" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding ProgressText}" FontWeight="SemiBold" Margin="0,0,0,8"
                           Visibility="{Binding ProgressLeft, Converter={StaticResource BoolVis}}" />
                <ProgressBar DockPanel.Dock="Top" Height="6" Value="{Binding DutProgress, Mode=OneWay}" Maximum="100"
                             Foreground="{StaticResource PrimaryBrush}" Background="#E9EEF4" BorderThickness="0" Margin="0,0,0,10"
                             Visibility="{Binding ProgressLeft, Converter={StaticResource BoolVis}}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Endlosschleife: Fortschritt des aktuellen Prüflings und Durchlaufzahl statt Gesamtprozentsatz." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Overview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="5" Padding="6,7" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="13" BorderThickness="2"
                                                BorderBrush="{Binding State, Converter={StaticResource StateBrush}}">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center"
                                                       Text="{Binding State, Converter={StaticResource StateGlyph}}"
                                                       Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Number}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================== Aktueller Inhalt -->
        <DockPanel Grid.Column="{Binding ContentColumn}" Grid.ColumnSpan="{Binding ContentSpan}" Grid.RowSpan="{Binding MainRowSpan}">
            <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBox}" Margin="0,0,0,10"
                    Visibility="{Binding DataContext.IncompleteRunsHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullVis}}">
                <TextBlock Text="{Binding DataContext.IncompleteRunsHint, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ErrorText}" />
            </Border>
            <ScrollViewer DockPanel.Dock="Top" MaxHeight="330" VerticalScrollBarVisibility="Auto">
                <views:LiveOutputPanel />
            </ScrollViewer>
            <!-- Aktueller Schritt und Fortschritt oben -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,10"
                    Visibility="{Binding ProgressTop, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ProgressBar Height="6" Value="{Binding DutProgress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"
                                 Foreground="{StaticResource PrimaryBrush}" Background="#E9EEF4" BorderThickness="0" />
                </DockPanel>
            </Border>
            <!-- Aktueller Schritt und Fortschritt unten -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,8" Margin="0,10,0,0"
                    Visibility="{Binding ProgressBottom, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <ProgressBar Height="6" Value="{Binding DutProgress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"
                                     Foreground="{StaticResource PrimaryBrush}" Background="#E9EEF4" BorderThickness="0" />
                    </DockPanel>
                    <TextBlock Text="{Binding CurrentStepName, StringFormat=Aktueller Schritt: {0}}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding CurrentStepName}" />
                <TextBlock Text="{Binding CurrentStepPath}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,12" />
            </StackPanel>

            <!-- Werkerabbruch: Exit-Folge innen → außen -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                    Visibility="{Binding IsAborting, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource FailBrush}" Margin="0,0,12,0">
                            <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Werkerabbruch angefordert" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Reguläre Schritte gestoppt. Abschlussgruppen werden von innen nach außen ausgeführt. Dies ist ein Software-Abbruch, kein Hardware-Not-Halt."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ExitSequence}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Rating, Converter={StaticResource RatingText}}" FontWeight="Bold"
                                                   VerticalAlignment="Center" Foreground="{Binding Rating, Converter={StaticResource RatingBrush}}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Auswahl-/Auftragsablauf: Prüfling erfassen und Prüfauftrag zuordnen (Abbildung „Prüfling erfassen“) -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18" DataContext="{Binding Selection}"
                    Visibility="{Binding ShowPanel, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ScanTitle}" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="{Binding ScanHint}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding ScanLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <DockPanel Grid.Column="1" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding AssignCommand}" Content="Zuordnen" Margin="8,0,0,0" />
                            <TextBox x:Name="KennungBox" Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditScan}" FontSize="18" FontWeight="SemiBold" Padding="6,4"
                                     beh:FocusBehavior.AutoFocus="True">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AssignCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Visibility="{Binding ShowOrderField, Converter={StaticResource BoolVis}}" Text="Auftrag" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Visibility="{Binding ShowOrderField, Converter={StaticResource BoolVis}}" Text="{Binding Auftrag, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" Padding="6,4" />
                        <TextBlock Grid.Row="2" Text="Test / Prüfvorschrift" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding TestText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Zuordnung" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                    <Border CornerRadius="6" Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource InfoLightBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnique}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PassLightBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource FailLightBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource PassBrush}" Margin="0,0,8,0"
                                           Visibility="{Binding IsUnique, Converter={StaticResource BoolVis}}" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource FailBrush}" Margin="0,0,8,0"
                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolVis}}" />
                                <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding ParametersText, StringFormat=Prüfparameter: {0}}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding ParametersText, Converter={StaticResource NullVis}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowManual, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding AlternativeText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding ManualChoice}" DisplayMemberPath="Title" MaxHeight="180" />
                    </StackPanel>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CompletedDuts, StringFormat=Geprüft in dieser Auswahl: {0}}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LastResult, StringFormat=Letzter Prüfling: {0}}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding LastResult, Converter={StaticResource NullVis}}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Werkerinteraktionen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InfoBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Contents.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="15" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Contents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" Margin="0,4,0,10" />
                                        <Image Source="{Binding ImagePath}" MaxHeight="220" HorizontalAlignment="Left" Margin="0,0,0,10"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}" />

                                        <!-- Eingabe -->
                                        <StackPanel Visibility="{Binding IsInput, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Width="260" FontSize="22"
                                                         IsEnabled="{Binding IsAwaiting}" beh:FocusBehavior.AutoFocus="True">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock Text="{Binding Unit}" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Auswahl -->
                                        <ItemsControl ItemsSource="{Binding Choices}" Visibility="{Binding IsChoice, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource OutlineButton}" Content="{Binding}" MinWidth="150" Height="52" FontSize="18" Margin="0,0,10,0"
                                                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" FontSize="14" Margin="0,6,0,0"
                                                   Visibility="{Binding Error, Converter={StaticResource NullVis}}" />

                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Height="54" Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch" MaxWidth="460"
                                                Visibility="{Binding IsAwaiting, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="White" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding ConfirmText}" FontSize="19" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsAnswered, Converter={StaticResource BoolVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource PassBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding AnswerText}" Foreground="{StaticResource PassBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ============================== Bewertung und Messwerte -->
        <DockPanel Grid.Column="4" Grid.RowSpan="{Binding MainRowSpan}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Bewertung (aktueller Prüfling)" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Icon}" FontSize="26" Margin="0,0,10,0"
                                       Text="{Binding DutRating, Converter={StaticResource RatingGlyph}}"
                                       Foreground="{Binding DutRating, Converter={StaticResource RatingBrush}}" />
                            <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding DutRating, Converter={StaticResource RatingText}}"
                                       Foreground="{Binding DutRating, Converter={StaticResource RatingBrush}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Ablaufstatus" />
                        <TextBlock FontSize="28" FontWeight="Bold" Text="WERROR" Foreground="{StaticResource FailBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding DutWerror, Converter={StaticResource BoolVis}}" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding StatusText}" Margin="0,8,0,0"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}"
                                   Visibility="{Binding DutWerror, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Kurven L1–L3 der letzten Aufnahme: Cursor (Klick), Zoom (Aufziehen/Mausrad, Doppelklick = alles), Effektivwerte -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12,10"
                    Visibility="{Binding HasLiveWaveform, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Kurven" Margin="0,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding LiveWaveformTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                    <views:WaveformPlot DataContext="{Binding LiveWaveform}" ShowToolbar="False" Height="230" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <CheckBox DockPanel.Dock="Right" Content="Alle anzeigen" IsChecked="{Binding ShowAllMeasurements}" VerticalAlignment="Center"
                                  Visibility="{Binding CanToggleMeasurements, Converter={StaticResource BoolVis}}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Messwerte" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="{Binding HiddenMeasurementsText}" Margin="0,0,0,4"
                               Visibility="{Binding HiddenMeasurementsText, Converter={StaticResource NullVis}}" />
                    <DataGrid ItemsSource="{Binding Measurements}" IsReadOnly="True" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="60" />
                            <DataGridTextColumn Header="Grenzwerte" Binding="{Binding Limits}" Width="*" />
                            <DataGridTemplateColumn Header="Ergebnis" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Width="20"
                                                       Text="{Binding Rating, Converter={StaticResource RatingGlyph}}"
                                                       Foreground="{Binding Rating, Converter={StaticResource RatingBrush}}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Rating, Converter={StaticResource RatingText}}"
                                                       Foreground="{Binding Rating, Converter={StaticResource RatingBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ============================== Protokoll -->
        <Border Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource Card}" Padding="14,10"
                Visibility="{Binding ShowProtocol, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Protokoll" />
                <views:ProtocolGrid />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
