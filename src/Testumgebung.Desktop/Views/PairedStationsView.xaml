<UserControl x:Class="Testumgebung.Desktop.Views.PairedStationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Testumgebung.Desktop.Views">
    <Grid DataContext="{Binding PairedStations}" Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14" Margin="6">
            <StackPanel>
                <TextBlock Text="Gemeinsamer Auftrag · zwei unabhängige Prüfseiten" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <TextBlock Text="Seite 1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding First.Name}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Seite 2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Second.Name}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Fertigungsauftrag" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="180" IsEnabled="{Binding CanConfigure}" Margin="0,0,12,0">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding StartCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Gemeinsam starten" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Beide abbrechen" Command="{Binding AbortCommand}" Style="{StaticResource DangerButton}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <views:PairedStationPane DataContext="{Binding First}"/>
            <views:PairedStationPane Grid.Column="1" DataContext="{Binding Second}"/>
        </Grid>
    </Grid>
</UserControl>
