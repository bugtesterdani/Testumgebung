<UserControl x:Class="Testumgebung.Desktop.Views.ProtocolGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: StationViewModel -->
    <DataGrid x:Name="ProtocolTable" ItemsSource="{Binding Protocol}" IsReadOnly="True" EnableRowVirtualization="True">
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="#F7F9FB" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <DataGridTextColumn Header="Zeit" Binding="{Binding TimeText}" Width="80" />
            <DataGridTemplateColumn Header="Ablauf · Schritt" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="KindIcon" Style="{StaticResource Icon}" FontSize="14" Width="22" Text="&#xE8A5;" />
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Measure">
                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE9D2;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Abort">
                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE71A;" />
                                <Setter TargetName="KindIcon" Property="Foreground" Value="{StaticResource FailBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE783;" />
                                <Setter TargetName="KindIcon" Property="Foreground" Value="{StaticResource FailBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Run">
                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE7B8;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Info">
                                <Setter TargetName="KindIcon" Property="Text" Value="&#xE946;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Iteration" Binding="{Binding Iteration}" Width="70" />
            <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="1.4*" />
            <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="70" />
            <DataGridTextColumn Header="Grenzwerte" Binding="{Binding Limits}" Width="110" />
            <DataGridTemplateColumn Header="Ergebnis" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Width="20"
                                       Text="{Binding Rating, Converter={StaticResource RatingGlyph}}"
                                       Foreground="{Binding Rating, Converter={StaticResource RatingBrush}}" />
                            <TextBlock Text="{Binding RatingText}" FontWeight="SemiBold"
                                       Foreground="{Binding Rating, Converter={StaticResource RatingBrush}}" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
