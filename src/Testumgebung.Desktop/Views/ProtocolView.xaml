<UserControl x:Class="Testumgebung.Desktop.Views.ProtocolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Testumgebung.Desktop.Views">
    <!-- Vollständiges Protokoll des gewählten Prüfplatzes -->
    <Border Style="{StaticResource Card}" Margin="16" DataContext="{Binding SelectedStation}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource PageTitle}" Text="Protokoll" />
                <TextBlock Text="{Binding Name}" FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="16,0,0,4" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Text="Ergebnisdatei und Datenbankübertragung folgen in Etappe 5 und 6." />
            <views:ProtocolGrid />
        </DockPanel>
    </Border>
</UserControl>
