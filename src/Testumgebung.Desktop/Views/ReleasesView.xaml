<UserControl x:Class="Testumgebung.Desktop.Views.ReleasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Testumgebung.Presentation.ViewModels;assembly=Testumgebung.Presentation">
    <!-- Release-Management (Abbildung Freigabeprüfung): Releases | Paket-Inhalt und Freigabe | Identität -->
    <Grid Margin="16" DataContext="{Binding ReleasesPage}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <!-- ============================== Releases und Paket -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Testprogramme" Style="{StaticResource SectionTitle}" />
                    <ComboBox x:Name="ReleaseProgramsList" ItemsSource="{Binding Programs}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding SelectedProgramName}" />
                    <TextBlock Text="{Binding ProgramStatus}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Aktualisieren" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource PageTitle}">
                            <Run Text="Release-Management – " /><Run Text="{Binding ProjectName, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="Ablage: " /><Run Text="{Binding StoreName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StoreError}" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                               Visibility="{Binding StoreError, Converter={StaticResource NullVis}}" />

                    <!-- Fortschritt Entwurf → Entwicklungsprüfung → Freigabe -->
                    <ItemsControl ItemsSource="{Binding Stages}" Margin="0,12,0,12" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
                                    <Grid Width="36" Height="36" Margin="0,0,10,0">
                                        <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Releaseliste und neuer Entwurf -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Releases" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock Text="Neuer Entwurf – Version" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding NewVersion, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leer = nächste freie Version" />
                            <Button Style="{StaticResource OutlineButton}" Command="{Binding CreateDraftCommand}" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Entwurf erstellen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,6">
                                        <TextBlock FontSize="17" FontWeight="SemiBold">
                                            <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LastChange, StringFormat=dd.MM.yyyy HH:mm}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Paketinhalt, Prüfung, Freigabe -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{Binding SelectedTitle}" />
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,10,0,0"
                                Background="{StaticResource InfoLightBrush}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ReleaseCommand}" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                                        <TextBlock Text="Ausdrücklich freigeben" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Version ausdrücklich freigeben" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                                               Text="Hiermit bestätige ich, dass das Paket vollständig geprüft wurde. Freigabe nur mit Recht „Freigeben“; Entwickeln und Freigeben können getrennt sein." />
                                    <CheckBox Content="Geprüftes Paket freigeben" IsChecked="{Binding Confirmed}" IsEnabled="{Binding CanConfirm}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                        <Run Text="Freigabe durch: " /><Run Text="{Binding ReleaseByText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding ReviewCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="Entwicklungsprüfung durchführen" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource FailBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Checks}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE73E;" Margin="0,0,6,0"
                                                       Foreground="{Binding Passed, Converter={StaticResource ErrorBrush}, ConverterParameter=invert}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="220" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Package}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="130" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" />
                                <DataGridTextColumn Header="Hash (SHA-256, gekürzt)" Binding="{Binding Hash}" Width="170" />
                                <DataGridTemplateColumn Header="Status" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE73E;" Margin="0,0,4,0"
                                                           Foreground="{Binding Ok, Converter={StaticResource ErrorBrush}, ConverterParameter=invert}" />
                                                <TextBlock Text="OK" Visibility="{Binding Ok, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Text="Fehler" Foreground="{StaticResource FailBrush}" Visibility="{Binding Ok, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================== Identität und Prüfplätze -->
        <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Identität und Berechtigungen" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16" Margin="0,0,8,0"
                                   Foreground="{Binding IsConfirmed, Converter={StaticResource ErrorBrush}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding IdentitySource}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="330" />
                    </StackPanel>
                    <TextBlock Text="{Binding UserName}" FontSize="16" />
                    <TextBlock Text="{Binding UserUpn}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <TextBlock Text="Rechte getrennt oder kombiniert" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <ItemsControl ItemsSource="{Binding Rights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="15" Text="&#xE73E;"
                                               Foreground="{Binding Granted, Converter={StaticResource ErrorBrush}, ConverterParameter=invert}" />
                                    <TextBlock Text="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource ErrorBox}" Margin="0,10,0,0" Visibility="{Binding IsDevelopmentMode, Converter={StaticResource BoolVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="Entwicklungsmodus: keine Zugangsdatei – simulierte Anmeldung mit allen Rechten. Für den Betrieb unter Einstellungen → Zugang die Entra-App und die Rechte je Konto hinterlegen." />
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Versionen auf den Prüfplätzen" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding StationVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Station}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="Laufender Prüfling behält seine gestartete Version. Eine neue Freigabe gilt frühestens ab dem nächsten Prüfling; ändert sie Init, Finalization oder den Loop, erst ab dem nächsten Start des Hauptablaufs. An- oder Abmelden während einer Prüfung stoppt die Prüfengine nicht." />
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Versionsvergleich" Margin="0,18,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Vergleicht den links gewählten Release mit einer anderen Version oder dem Editorstand (Knoten, Parameter, Variablen, CodeBlocks, Kurven, Werkeransicht, Simulation)." />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding CompareCommand}" Content="Vergleichen" Margin="6,0,0,0" />
                        <ComboBox ItemsSource="{Binding CompareTargets}" SelectedItem="{Binding CompareWith}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CompareStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding CompareStatus, Converter={StaticResource NullVis}}" />
                    <ItemsControl ItemsSource="{Binding Differences}" MaxHeight="320">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                    <StackPanel>
                                        <TextBlock FontSize="12" TextWrapping="Wrap">
                                            <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                            <Run Text=" · " /><Run Text="{Binding Area, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            <Run Text=" · " /><Run Text="{Binding Item, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Prüfbericht" Margin="0,18,0,6"
                               Visibility="{Binding ReviewReport, Converter={StaticResource NullVis}}" />
                    <TextBlock Text="{Binding ReviewReport}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================== Audit-Log -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AuditState}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Audit-Log (unveränderlich)" Margin="0" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="50" />
                        <DataGridTextColumn Header="Zeit" Binding="{Binding Time, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="150" />
                        <DataGridTextColumn Header="Benutzer" Binding="{Binding User}" Width="200" />
                        <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="230" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
