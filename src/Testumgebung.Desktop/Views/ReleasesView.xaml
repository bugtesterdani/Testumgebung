<UserControl x:Class="Testumgebung.Desktop.Views.ReleasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Testumgebung.Presentation.ViewModels;assembly=Testumgebung.Presentation">
    <!-- Release-Management (Abbildung Freigabeprüfung): Releases | Paket-Inhalt und Freigabe | Identität -->
    <Grid Margin="16" DataContext="{Binding ReleasesPage}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- All workflow actions remain reachable even in a short window or with long program names. -->
        <Border Style="{StaticResource Card}">
            <ScrollViewer x:Name="ReleaseMainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <Button Content="Programmquellen &amp; Versionen …" Click="OnOpenSources" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Text="Testprogramme" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="ReleaseProgramsList" ItemsSource="{Binding Programs}" TextSearch.TextPath="Name" SelectedValuePath="Name"
                              SelectedItem="{Binding SelectedProgram}" MinHeight="30" AutomationProperties.Name="Testprogramm für Release-Verwaltung">
                        <ComboBox.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ProgramStatus}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,10"/>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Aktualisieren" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Top"/>
                        <TextBlock Style="{StaticResource PageTitle}" FontSize="24" TextWrapping="Wrap">
                            <Run Text="Release-Management – "/><Run Text="{Binding ProjectName, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                        <Run Text="Ablage: "/><Run Text="{Binding StoreName, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel x:Name="ReleaseErrorPanel" Margin="0,6,0,0" Visibility="{Binding StoreError, Converter={StaticResource NullVis}}">
                        <TextBlock Text="Freigaben konnten nicht vollständig geladen werden." Style="{StaticResource ErrorText}" TextWrapping="Wrap"/>
                        <Expander x:Name="ReleaseErrorDetails" Header="Details anzeigen" Margin="0,4,0,0">
                            <TextBox Text="{Binding StoreError, Mode=OneWay}" IsReadOnly="True" MaxHeight="140" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Details zur Release-Meldung"/>
                        </Expander>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Stages}" Margin="0,12,0,4">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <DockPanel Width="220" Margin="0,0,14,10">
                                <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2">
                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="White"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers>
                                        </Style></Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Versionen"/>
                            <ListBox ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected}" BorderThickness="0" MinHeight="120" MaxHeight="340"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="2,6">
                                        <TextBlock FontSize="17" FontWeight="SemiBold"><Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LastChange, StringFormat=dd.MM.yyyy HH:mm}"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Neuer Entwurf – Version" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding NewVersion, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leer = nächste freie Version"/>
                            <Button Content="Entwurf erstellen" Style="{StaticResource OutlineButton}" Command="{Binding CreateDraftCommand}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedTitle}" TextWrapping="Wrap"/>
                            <Button x:Name="LoadReleaseInEditorButton" Content="In Ablaufeditor laden" Command="{Binding LoadInEditorCommand}"
                                    Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,0,0,6"
                                    ToolTip="Gewählte Version als lokale Bearbeitungsfassung öffnen. Gespeicherte Freigaben bleiben erhalten."/>
                            <TextBox x:Name="ReleaseSourceDetails" Text="{Binding SelectedSourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/>
                            <DataGrid x:Name="ReleasePackageList" ItemsSource="{Binding Package}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="30" Height="210">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bereich" Binding="{Binding Area}" Width="90"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="60"/>
                                    <DataGridTextColumn Header="Hash (gekürzt)" Binding="{Binding Hash}" Width="120"/>
                                    <DataGridTemplateColumn Header="Status" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="OK" Visibility="{Binding Ok, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="Fehler" Foreground="{StaticResource FailBrush}" Visibility="{Binding Ok, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="1. Entwicklungsprüfung" FontSize="16" FontWeight="SemiBold"/>
                                    <Button x:Name="ReleaseReviewButton" Content="Entwicklungsprüfung durchführen" Command="{Binding ReviewCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource FailBrush}"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Checks}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Binding Passed, Converter={StaticResource ErrorBrush}, ConverterParameter=invert}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0" Background="{StaticResource InfoLightBrush}">
                                <StackPanel>
                                    <TextBlock Text="2. Ausdrücklich freigeben" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ReleaseInstruction}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <CheckBox Content="Geprüftes Paket freigeben" IsChecked="{Binding Confirmed}" IsEnabled="{Binding CanConfirm}"/>
                                    <Button x:Name="ReleaseApproveButton" Content="Ausdrücklich freigeben" Command="{Binding ReleaseCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,4"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"><Run Text="Freigabe: "/><Run Text="{Binding ReleaseByText, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================== Identität und Prüfplätze -->
        <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Identität und Berechtigungen" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16" Margin="0,0,8,0"
                                   Foreground="{Binding IsConfirmed, Converter={StaticResource ErrorBrush}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding IdentitySource}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="280" />
                    </DockPanel>
                    <TextBlock Text="{Binding UserName}" FontSize="16" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UserUpn}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="Rechte getrennt oder kombiniert" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <ItemsControl ItemsSource="{Binding Rights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="15" Text="&#xE73E;"
                                               Foreground="{Binding Granted, Converter={StaticResource ErrorBrush}, ConverterParameter=invert}" />
                                    <TextBlock Text="{Binding Label}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource ErrorBox}" Margin="0,10,0,0" Visibility="{Binding IsDevelopmentMode, Converter={StaticResource BoolVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="Entwicklungsmodus: keine Zugangsdatei – simulierte Anmeldung mit allen Rechten. Für den Betrieb unter Einstellungen → Zugang die Entra-App und die Rechte je Konto hinterlegen." />
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Versionen auf den Prüfplätzen" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding StationVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Station}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="Laufender Prüfling behält seine gestartete Version. Eine neue Freigabe gilt frühestens ab dem nächsten Prüfling; ändert sie Init, Finalization oder den Loop, erst ab dem nächsten Start des Hauptablaufs. An- oder Abmelden während einer Prüfung stoppt die Prüfengine nicht." />
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Versionsvergleich" Margin="0,18,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Vergleicht den links gewählten Release mit einer anderen Version oder dem Editorstand (Knoten, Parameter, Variablen, CodeBlocks, Kurven, Werkeransicht, Simulation)." />
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding CompareCommand}" Content="Vergleichen" Margin="6,0,0,0" />
                        <ComboBox ItemsSource="{Binding CompareTargets}" SelectedItem="{Binding CompareWith}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CompareStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding CompareStatus, Converter={StaticResource NullVis}}" />
                    <ItemsControl ItemsSource="{Binding Differences}" MaxHeight="320">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                    <StackPanel>
                                        <TextBlock FontSize="12" TextWrapping="Wrap">
                                            <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                            <Run Text=" · " /><Run Text="{Binding Area, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            <Run Text=" · " /><Run Text="{Binding Item, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Prüfbericht" Margin="0,18,0,6"
                               Visibility="{Binding ReviewReport, Converter={StaticResource NullVis}}" />
                    <TextBlock Text="{Binding ReviewReport}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================== Audit-Log -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AuditState}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Audit-Log (unveränderlich)" Margin="0" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Audit}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="50" />
                        <DataGridTextColumn Header="Zeit" Binding="{Binding Time, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="150" />
                        <DataGridTextColumn Header="Benutzer" Binding="{Binding User}" Width="200" />
                        <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="230" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
