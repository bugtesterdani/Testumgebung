<UserControl x:Class="Testumgebung.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Auswertung & Berichte: Filter | Kennzahlen, Fehler-Pareto, Messwertstatistik mit Histogramm, Tagesverlauf -->
    <UserControl.Resources>
        <DataTemplate x:Key="BarTemplate">
            <StackPanel Width="34" Margin="1,0" ToolTip="{Binding Tooltip}">
                <Grid Height="90">
                    <Border VerticalAlignment="Bottom" CornerRadius="2,2,0,0" Margin="3,0">
                        <Border.Height>
                            <Binding Path="Height" Converter="{StaticResource BarHeight}" ConverterParameter="90" />
                        </Border.Height>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Highlight}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource FailBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Label}" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16" DataContext="{Binding ReportsPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CsvCommand}" Content="CSV …" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PdfCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                        <TextBlock Text="Bericht (PDF) …" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Auswertung &amp; Berichte" />
                <TextBlock Text="Ausbeute, Fehlerhäufigkeit und Prozessfähigkeit aus den Ergebnisdateien; Prüfberichte je Prüfling unter „Ergebnisse“."
                           FontSize="14" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- ============================== Filter -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Datenquelle" />
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Margin="0,0,0,6" />
                    <StackPanel Visibility="{Binding IsFolderSource, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Label}" Text="Ergebnisordner" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DatabaseHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding IsFolderSource, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <TextBlock Text="Zeitraum, Test und Prüfplatz der Filter werden beim Laden aus der Datenbank berücksichtigt."
                               Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding IsFolderSource, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding LoadCommand}" Content="Laden" HorizontalAlignment="Left" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Problems}" MaxHeight="90">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" FontSize="11" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Filter" Margin="0,14,0,4" />
                    <TextBlock Style="{StaticResource Label}" Text="Von / bis" />
                    <DockPanel Margin="0,2,0,6">
                        <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding From}" Width="130" />
                        <DatePicker SelectedDate="{Binding To}" Margin="8,0,0,0" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Test" />
                    <ComboBox ItemsSource="{Binding Tests}" Text="{Binding Test}" IsEditable="True" Margin="0,2,0,6" />
                    <TextBlock Style="{StaticResource Label}" Text="Version" />
                    <ComboBox ItemsSource="{Binding Versions}" Text="{Binding Version}" IsEditable="True" Margin="0,2,0,6" />
                    <TextBlock Style="{StaticResource Label}" Text="Prüfplatz" />
                    <ComboBox ItemsSource="{Binding Stations}" Text="{Binding Station}" IsEditable="True" Margin="0,2,0,6" />
                    <TextBlock Style="{StaticResource Label}" Text="Kennung (Platzhalter * ?)" />
                    <TextBox Text="{Binding DutPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                    <CheckBox Content="Entwicklungsläufe einbeziehen" IsChecked="{Binding IncludeDevelopment}" Margin="0,2,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Content="Auswerten" Margin="0,0,8,0" />
                        <Button Style="{StaticResource ToolButton}" Command="{Binding ResetFilterCommand}" Content="Zurücksetzen" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================== Ergebnis -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding FilterText}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Prüfläufe" />
                            <TextBlock Text="{Binding RunsText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Ausbeute je Lauf" />
                            <TextBlock Text="{Binding YieldText}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="First Pass Yield / Endausbeute" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FpyText}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="{Binding FinalYieldText, StringFormat=' / {0}'}" FontSize="16" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Prüflinge · mittlere Dauer" />
                            <TextBlock Text="{Binding DutsText}" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding DurationText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Fehlerhäufigkeit je Schritt (Pareto)" />
                        <DataGrid ItemsSource="{Binding Failures}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="260" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Schritt" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Läufe" Binding="{Binding Runs}" Width="60" />
                                <DataGridTextColumn Header="FAIL" Binding="{Binding Fail}" Width="60" />
                                <DataGridTextColumn Header="ERROR" Binding="{Binding Error}" Width="60" />
                                <DataGridTextColumn Header="häufigste Meldung" Binding="{Binding TypicalMessage}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Messwerte und Prozessfähigkeit" />
                        <DataGrid ItemsSource="{Binding Measurements}" SelectedItem="{Binding SelectedMeasurement}" IsReadOnly="True" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" MaxHeight="300" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Messwert" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="60" />
                                <DataGridTextColumn Header="n" Binding="{Binding Count}" Width="50" />
                                <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat=G5}" Width="*" />
                                <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat=G5}" Width="*" />
                                <DataGridTextColumn Header="Mittel" Binding="{Binding Mean, StringFormat=G5}" Width="*" />
                                <DataGridTextColumn Header="σ" Binding="{Binding StdDev, StringFormat=G4}" Width="*" />
                                <DataGridTextColumn Header="außerhalb" Binding="{Binding OutOfLimits}" Width="70" />
                                <DataGridTextColumn Header="Cpk" Binding="{Binding Cpk, StringFormat=0.00}" Width="60" />
                                <DataGridTextColumn Header="Bewertung" Binding="{Binding Capability}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding MeasurementText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,4" />
                        <ItemsControl ItemsSource="{Binding Histogram}" ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Text="Histogramm des gewählten Messwerts; rot = Klassen außerhalb der Grenzwerte." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Prüfläufe je Tag (letzte 31 Tage mit Läufen)" />
                        <ItemsControl ItemsSource="{Binding Daily}" ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" Text="Rot = Tage mit FAIL oder ERROR. Details im Tooltip." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
