<UserControl x:Class="Testumgebung.Desktop.Views.SelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Auswahl und Auftragsablauf (Abbildung „Auswahl und Auftragsablauf konfigurieren“): Auswahlmethoden, Kennungsregeln,
         Meldungen, Regel-Simulation | eigener Auswahlablauf, Ausgabevertrag -->
    <Grid Margin="16" DataContext="{Binding SelectionPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <ComboBox ItemsSource="{Binding StationNames}" SelectedItem="{Binding SelectedStation}" Width="170" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding DiscardCommand}" Margin="0,0,8,0" Content="Verwerfen" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="Auswahl speichern" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Auswahl und Auftragsablauf" />
                    <TextBlock Text="Konfiguration der Testauswahl und des Auftragsablaufs für diesen Prüfplatz." FontSize="14" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource InfoBox}" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Auftragsmodus: Fertigungsauftrag scannen → Auswahlablauf → Start einmal → Loop mit neuer Seriennummer je Prüfling → End bei Abbruch → Fertigungsauftrag erneut scannen." />
            </Border>
            <Border Style="{StaticResource ErrorBox}" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
            </Border>
            <Border Style="{StaticResource InfoBox}" Margin="0,8,0,0" Visibility="{Binding Status, Converter={StaticResource NullVis}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
            </Border>
        </StackPanel>

        <!-- ============================== links -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Auswahlmethoden -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. Auswahlmethoden (unabhängig aktivierbar)" />
                        <CheckBox IsChecked="{Binding UseSelection}" Margin="0,4,0,8" FontWeight="SemiBold"
                                  Content="Auswahl-/Auftragsablauf für diesen Prüfplatz verwenden" />
                        <CheckBox IsChecked="{Binding OrderSession}" IsEnabled="{Binding UseSelection}" Margin="16,0,0,10" Content="Fertigungsauftrag startet eine endlose Prüfsitzung (sonst Einzelprüfling-Modus)" />
                        <Grid IsEnabled="{Binding UseSelection}" Margin="16,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox IsChecked="{Binding UseManual}" Content="Manuell" FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Column="1" Text="Test manuell durch den Werker auswählen." VerticalAlignment="Center" />
                            <CheckBox Grid.Row="1" IsChecked="{Binding UseRules}" Content="Kennungsregeln" FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Automatische Zuordnung über Kennungsmuster." VerticalAlignment="Center" />
                            <CheckBox Grid.Row="2" IsChecked="{Binding UseCustom}" Content="Eigener Auswahlablauf" FontWeight="SemiBold" Margin="0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Abfolge der Auswahl in einem eigenen Ablauf (rechts)." VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding MethodsText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 2. Kennungsregeln -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding UseSelection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource OutlineButton}" Command="{Binding AddRuleCommand}" Content="+ Regel hinzufügen" Margin="0,0,8,0" />
                                <Button Style="{StaticResource ToolButton}" Command="{Binding RemoveRuleCommand}" Content="Löschen" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="2. Kennungsregeln" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="32" MinHeight="90" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Priorität" Binding="{Binding Priority, UpdateSourceTrigger=LostFocus}" Width="0.5*" />
                                <DataGridTextColumn Header="Kennungsmuster" Binding="{Binding Pattern, UpdateSourceTrigger=LostFocus}" Width="1.1*" />
                                <DataGridTemplateColumn Header="Testkennung" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True" Text="{Binding Test, UpdateSourceTrigger=LostFocus}" BorderThickness="0" Background="Transparent"
                                                      ItemsSource="{Binding DataContext.TestNames, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version, UpdateSourceTrigger=LostFocus}" Width="1.1*" />
                                <DataGridTextColumn Header="Prüfparameter" Binding="{Binding Parameters, UpdateSourceTrigger=LostFocus}" Width="1.3*" />
                                <DataGridTemplateColumn Header="Freigegeben" Width="0.8*" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource PassBrush}" Margin="0,0,6,0"
                                                           Visibility="{Binding IsReleased, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Text="{Binding ReleasedText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource InfoBox}" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="Platzhalter: * beliebig, ? ein Zeichen, # eine Ziffer; „re:…“ = regulärer Ausdruck. Kleinere Priorität gewinnt. Mehrere Treffer gleicher Priorität: Fehlermeldung und alternative Auswahl." />
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Meldung bei keiner eindeutigen Zuordnung" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NoMatchMessage, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Alternativer Button-Text" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AlternativeText, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Regel-Simulation -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Regel-Simulation" />
                            <TextBlock Style="{StaticResource Label}" Text="Scan (Auftragsmodus: Fertigungsauftrag)" Margin="0,4,0,4" />
                            <TextBox Text="{Binding SampleId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Label}" Text="Auftrag (nur im Einzelprüfling-Modus)" Margin="0,8,0,4" />
                            <TextBox Text="{Binding SampleOrder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Style="{StaticResource OutlineButton}" Command="{Binding SimulateCommand}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Prüfen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="6" Padding="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                Visibility="{Binding HasSimulation, Converter={StaticResource BoolVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource FailLightBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SimulationOk}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PassLightBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="{Binding SimulationText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="Test" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SimulationTest}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Text="Auftrag" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SimulationOrder}" />
                                <TextBlock Grid.Row="3" Text="Parameter" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SimulationParameters}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="Quelle" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SimulationSource}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================== rechts -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding UseCustom}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="3. Eigener Auswahlablauf" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="Ein Ablaufprojekt (z. B. Auftrag aus Datenbank lesen, CodeBlock-Zuordnung) mit dem Baustein „Test auswählen“. Es erhält Kennung und Auftrag als Vorbelegung und läuft vor den Kennungsregeln." />
                        <TextBlock Style="{StaticResource Label}" Text="Projektdatei" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding BrowseCustomCommand}" Content="Durchsuchen …" Margin="6,0,0,0" />
                            <TextBox Text="{Binding CustomProject, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="4. Ausgabevertrag (Ergebnis der Auswahl)" />
                        <ItemsControl ItemsSource="{Binding Contract}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Type}" FontSize="11" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
