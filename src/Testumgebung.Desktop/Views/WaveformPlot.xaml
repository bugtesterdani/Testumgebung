<UserControl x:Class="Testumgebung.Desktop.Views.WaveformPlot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Kurvenanzeige: Kanalauswahl, Zoom (Aufziehen, Mausrad, Schaltflächen), Cursor mit Werten, Effektivwerte im Ansichtsfenster.
         DataContext: WaveformPlotViewModel -->
    <DockPanel>
        <!-- Werkzeugleiste -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" x:Name="Toolbar">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomInCommand}" ToolTip="Vergrößern (Mausrad oder Bereich aufziehen)">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomOutCommand}" ToolTip="Verkleinern">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomAllCommand}" ToolTip="Gesamte Kurve">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PanLeftCommand}" ToolTip="Nach links verschieben">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding PanRightCommand}" ToolTip="Nach rechts verschieben">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearCursorCommand}" ToolTip="Cursor entfernen">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="14" />
                </Button>
                <TextBlock Text="{Binding ViewText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding CursorText}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>

        <!-- Kanäle: Sichtbarkeit, Wert am Cursor, Effektivwert -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Channels}" Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Rectangle Width="16" Height="4" Fill="{Binding ColorIndex, Converter={StaticResource SeriesBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" [" /><Run Text="{Binding Unit, Mode=OneWay}" /><Run Text="]" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Run Text="Cursor " /><Run Text="{Binding CursorText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                                <Run Text="Eff. " /><Run Text="{Binding RmsText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Y-Achse -->
            <Grid Margin="0,6,6,6" MinWidth="40">
                <TextBlock Text="{Binding YTopText}" Style="{StaticResource Caption}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding YMidText}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding YBottomText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
            </Grid>
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="#FBFCFE" ClipToBounds="True">
                <Grid>
                    <Viewbox Stretch="Fill" Margin="6">
                        <Grid x:Name="PlotSurface" Width="1000" Height="260" Background="Transparent" Cursor="Cross"
                              MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" MouseWheel="OnWheel">
                            <Line X1="0" X2="1000" Y1="65" Y2="65" Stroke="#EEF1F5" StrokeThickness="1" />
                            <Line X1="0" X2="1000" Y1="130" Y2="130" Stroke="#EEF1F5" StrokeThickness="1" />
                            <Line X1="0" X2="1000" Y1="195" Y2="195" Stroke="#EEF1F5" StrokeThickness="1" />
                            <Line X1="0" X2="1000" Y1="{Binding ZeroY}" Y2="{Binding ZeroY}" Stroke="{StaticResource IdleBrush}" StrokeThickness="1"
                                  Visibility="{Binding ShowZero, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding Series}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Points, Converter={StaticResource PlotPoints}}"
                                                  Stroke="{Binding ColorIndex, Converter={StaticResource SeriesBrush}}" StrokeThickness="1.6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Line X1="{Binding CursorX}" X2="{Binding CursorX}" Y1="0" Y2="260" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                                  StrokeDashArray="4 3" IsHitTestVisible="False" Visibility="{Binding HasCursor, Converter={StaticResource BoolVis}}" />
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="DragRect" Height="260" Fill="#331565D8" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="Keine Kurve" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasData, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
